    <worksheet name='Sheet 7'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Failed rate by day of week&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='my_payments_prepared (payments)' name='federated.01d7uo71c1xkxc1gxc5mi10l0ljb' />
          </datasources>
          <datasource-dependencies datasource='federated.01d7uo71c1xkxc1gxc5mi10l0ljb'>
            <column caption='Failed rate' datatype='real' default-format='p0.00%' name='[Calculation_0588874375200768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(INT([is_failed]))' />
            </column>
            <column caption='Weekday' datatype='string' name='[Calculation_0588874461175811]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [event_date])' />
            </column>
            <column caption='Weekday order(Mon-1)' datatype='integer' name='[Calculation_0588874464411654]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;, [event_date]) = 1 THEN 7&#10;ELSE DATEPART(&apos;weekday&apos;, [event_date]) -1&#10;END' />
            </column>
            <column caption='Event Date' datatype='date' name='[event_date]' role='dimension' type='ordinal' />
            <column caption='Is Failed' datatype='boolean' name='[is_failed]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0588874464411654]' derivation='Min' name='[min:Calculation_0588874464411654:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0588874461175811]' derivation='None' name='[none:Calculation_0588874461175811:nk]' pivot='key' type='nominal' />
